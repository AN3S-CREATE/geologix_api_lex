{
  "version": "2",
  "flowTitle": "Proxy — xAI Grok",
  "trigger": {
    "valid": true,
    "type": "WEBHOOK",
    "settings": {
      "input": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "Input for model"
          },
          "stream": {
            "type": "string",
            "description": "Input for stream"
          },
          "messages": {
            "type": "string",
            "description": "Input for messages"
          },
          "max_tokens": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "actions": [
    {
      "name": "a1b2c3d4-0001-0001-0001-000000000001",
      "valid": true,
      "displayName": "Call xAI Grok API",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-piece-http",
        "pieceVersion": "1.0.0",
        "actionName": "http.sendRequest",
        "input": {
          "url": "https://api.x.ai/v1/chat/completions",
          "body": "{{ trigger[\"body\"][\"messages\"] }}",
          "method": "POST",
          "bodyType": "json",
          "responseType": "json"
        }
      }
    }
  ],
  "outputs": [
    {
      "type": "http_response",
      "body": {
        "type": "json",
        "data": {
          "type": "basic",
          "payload": [
            {
              "data": "{{ a1b2c3d4-0001-0001-0001-000000000001[\"data\"] }}"
            },
            {
              "status": "{{ a1b2c3d4-0001-0001-0001-000000000001[\"status\"] }}"
            }
          ]
        }
      },
      "key": "trigger"
    }
  ]
}