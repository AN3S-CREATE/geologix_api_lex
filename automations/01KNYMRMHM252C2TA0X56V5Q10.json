{
  "version": "2",
  "flowTitle": "Sync Knowledge from Drive",
  "trigger": {
    "valid": false,
    "displayName": "New file in folder",
    "type": "PIECE_TRIGGER",
    "settings": {
      "pieceName": "@taskade/automade-piece-google-drive",
      "pieceVersion": "1.0.0",
      "triggerName": "new_fileV2",
      "input": {}
    }
  },
  "actions": [
    {
      "name": "a1b2c3d4-e5f6-7890-ab12-cd3456789012",
      "valid": true,
      "displayName": "Extract file text",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-media",
        "pieceVersion": "1.0.0",
        "actionName": "pdf.convertToText",
        "input": {
          "pdfUrl": "{{ trigger[\"fileUrl\"] }}"
        }
      }
    },
    {
      "name": "b2c3d4e5-f678-90ab-cd12-ef3456789012",
      "valid": false,
      "displayName": "Add to assistant knowledge",
      "type": "PIECE",
      "settings": {
        "pieceName": "@taskade/automade-internalpiece-openai",
        "pieceVersion": "1.0.0",
        "actionName": "agent.add_knowledge.v2",
        "input": {
          "title": "{{ trigger[\"file\"] }}",
          "agentId": {
            "type": "flow-template-variable-input-type",
            "id": "01KNSYW9HK6YT9VPFAP1AVEHRW"
          },
          "knowledge": "{{ a1b2c3d4-e5f6-7890-ab12-cd3456789012[\"content\"] }}",
          "knowledgeType": "text"
        }
      }
    }
  ],
  "variables": {
    "01KNSYW9HK6YT9VPFAP1AVEHRW": {
      "id": "01KNSYW9HK6YT9VPFAP1AVEHRW",
      "rank": "V",
      "type": "string",
      "format": "taskade-space-agent-id"
    }
  }
}